{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "": true,
    "**/.brain-memory": true,
    "**/hippocampus_store": true,
    "**/knowledge_inbox": true,
    "**/memory_store": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/models": true,
    "**/*.gguf": true,
    "**/Desktop": true
  },
  "eslint.enable": true,
  "eslint.workingDirectories": [{ "mode": "location" }],
  "prettier.enable": true,
  "prettier.requireConfig": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "jest.enable": true,
  "jest.rootPath": "${workspaceFolder}",
  "cSpell.words": [
    "amygdala",
    "brainstem",
    "cerebellum",
    "corpus",
    "callosum",
    "hippocampus",
    "interoception",
    "neurocognitively",
    "thalamus",
    "SomaOS",
    "wernicke",
    "broca",
    "basal",
    "ganglia",
    "cingulate",
    "gyrus",
    "pineal",
    "hypothalamus",
    "LLM",
    "GWT",
    "ACT-R",
    "JEPA",
    "RPE",
    "DMN",
    "pGNW",
    "Hebbian",
    "CLS"
  ]
}
