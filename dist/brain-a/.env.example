# 环境变量模板 —— 复制为 .env 后填入真实值
# 未设置的项一律使用代码内置默认值，因此最小配置只需 LLM_* 或 LOCAL_* 之一。

# ── 推理模式：api | local ──────────────────────────────────────────
LLM_MODE=api

# 外部 API（LLM_MODE=api 时生效）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=8192

# 本地推理（LLM_MODE=local 时生效）
LOCAL_INFERENCE_ENABLED=true
LOCAL_LLM_PATH=models/llm/model.gguf
LOCAL_VLM_PATH=models/vlm/vlm.gguf
LOCAL_VLM_MMPROJ=models/vlm/mmproj.gguf
LOCAL_STT_PATH=models/speech/stt.bin
LOCAL_TTS_PATH=models/speech/tts.onnx
LOCAL_EMB_PATH=models/embedding

LOCAL_LLM_PORT=18080
LOCAL_VLM_PORT=18081
LOCAL_STT_PORT=18090
LOCAL_TTS_PORT=18091

LOCAL_GPU_LAYERS=99
LOCAL_CONTEXT_SIZE=16384
LOCAL_THREADS=6
LOCAL_BATCH_SIZE=2048

# 多模型编排（关闭时单模型直连）
MULTI_MODEL_ENABLED=false

# 高层规划器（留空即自动禁用）
PLANNER_ENDPOINT=
PLANNER_MODEL=
PLANNER_TIMEOUT_MS=15000

# ── 机器人 ────────────────────────────────────────────────────────
FRANKA_IP=192.168.1.100
SO100_PORT=/dev/ttyUSB0

# ── 安全 ──────────────────────────────────────────────────────────
# 急停复位令牌：未设置时拒绝任何复位请求，急停保持闭锁
SOMAOS_SAFETY_RESET_TOKEN=

# ── 运行时 ────────────────────────────────────────────────────────
LOG_LEVEL=info
SOMAOS_GATEWAY_TRANSPORT=auto
SOMAOS_PYTHON=

# ── 可选外部服务（留空即离线降级）────────────────────────────────
ANYSEARCH_API_KEY=
TEVILY_API_KEY=
