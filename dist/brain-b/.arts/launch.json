{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🚀 Launch Brain (Full)",
      "program": "${workspaceFolder}/index.js",
      "args": [],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🧠 Brain-Only Mode",
      "program": "${workspaceFolder}/index.js",
      "args": ["brain-only"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "📊 Brain Status",
      "program": "${workspaceFolder}/index.js",
      "args": ["brain-status"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "💬 Web Chat Mode",
      "program": "${workspaceFolder}/index.js",
      "args": ["chat"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🔍 Diagnostic",
      "program": "${workspaceFolder}/comprehensive_diagnostic.js",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🧪 Smoke Test",
      "program": "${workspaceFolder}/smoke_test.js",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🧪 Run All Tests (Jest)",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": ["--runInBand", "--verbose"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🧪 Run Current Test File",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": ["${relativeFile}", "--runInBand", "--verbose"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "🔗 Attach to Process",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
