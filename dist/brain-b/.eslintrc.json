{
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-var": "warn",
    "prefer-const": "warn",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-empty": ["warn", { "allowEmptyCatch": false }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-constant-condition": ["error", { "checkLoops": false }],
    "no-prototype-builtins": "off",
    "no-case-declarations": "warn",
    "no-undef": "error",
    "no-redeclare": "error",
    "no-dupe-keys": "error",
    "eqeqeq": ["warn", "smart"],
    "curly": ["warn", "multi-line"],
    "no-throw-literal": "error",
    "require-atomic-updates": "warn",
    "no-async-promise-executor": "error",
    "no-misleading-character-class": "error",
    "no-template-curly-in-string": "warn",
    "no-unreachable": "warn"
  },
  "globals": {
    "require": "readonly",
    "module": "readonly",
    "exports": "readonly",
    "__dirname": "readonly",
    "__filename": "readonly",
    "process": "readonly",
    "Buffer": "readonly",
    "setTimeout": "readonly",
    "clearTimeout": "readonly",
    "setInterval": "readonly",
    "clearInterval": "readonly",
    "setImmediate": "readonly",
    "clearImmediate": "readonly",
    "console": "readonly",
    "Promise": "readonly",
    "JSON": "readonly",
    "Math": "readonly",
    "Date": "readonly",
    "Array": "readonly",
    "Object": "readonly",
    "Map": "readonly",
    "Set": "readonly",
    "String": "readonly",
    "Number": "readonly",
    "Boolean": "readonly",
    "RegExp": "readonly",
    "Error": "readonly",
    "Intl": "readonly"
  },
  "ignorePatterns": [
    "node_modules/",
    "scripts/generated/",
    "scripts/backups/",
    "Desktop/",
    "*.bak",
    "*.bak.*",
    "logs/",
    "models/",
    "dist/",
    "coverage/"
  ]
}
