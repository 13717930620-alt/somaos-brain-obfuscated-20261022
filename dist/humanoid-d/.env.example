# SomaOS Brain Next — environment template
# Copy to `.env` and fill in what you need. All variables are optional;
# the runtime degrades gracefully when a variable is absent.
#
# NOTE: scripts/launch.js (legacy) is the only component that loads .env via
# dotenv. The current entrypoint `node src/index.js` reads plain environment
# variables only, so export them in your shell / .bat as well if needed.

# ---- HTTP runtime ----
SOMAOS_PORT=3002

# ---- Embodiment (humanoid) ----
# Path to the humanoid joint definition. Defaults to config/humanoid.json.
# If the file is missing, the kernel falls back to the legacy 6-DOF arm behaviour.
# SOMAOS_HUMANOID_CONFIG=config/humanoid.json

# ---- Robot backend ----
# 'http' -> connect to a real driver (dataplane/feetech_driver.pyc, default :3110)
# unset  -> in-process HumanoidBackend (24 DOF simulation stub)
# SOMAOS_ROBOT_BACKEND=http
SOMAOS_ROBOT_URL=http://127.0.0.1:3110

# ---- Data plane (native C++/ROS2 or local bridge on :3101) ----
# Leave unset to run the JS fallback. Set to enable /data-plane/* proxying.
# SOMAOS_DATA_PLANE_URL=http://127.0.0.1:3101
# SOMAOS_DATA_PLANE_TOKEN=
# SOMAOS_DATA_PLANE_PORT=3101
# SOMAOS_DATA_PLANE_HOST=127.0.0.1

# ---- Local LLM / VLM (llama.cpp OpenAI-compatible) ----
# SOMAOS_LOCAL_LLM_URL=http://127.0.0.1:18080/v1
# SOMAOS_LOCAL_LLM_MODEL=qwen3-14b-instruct-q4_k_m
# SOMAOS_LOCAL_VLM_URL=http://127.0.0.1:18081/v1

# ---- GR00T VLA policy server ----
# SOMAOS_GROOT_URL=http://127.0.0.1:8001

# ---- Remote AI dialogue (optional) ----
# OPENROUTER_API_KEY=sk-or-v1-xxxx
# SOMAOS_MODEL_ID=stealth/ox-alpha

# ---- Safety ----
# Required to POST /safety/reset (recover from emergency stop)
# SOMAOS_SAFETY_RESET_TOKEN=change-me

# ---- OpenCastor / hardware ----
# SOMAOS_HW_PRESET=mujoco
# SOMAOS_FLEET=false          # set false to disable the fleet adapter
# SOMAOS_FLEET_URL=           # a real fleet endpoint; without it fleet runs in 'simulated' mode

# ---- Misc ----
# SOMAOS_ROBOT_STATE_HZ=5
# SOMAOS_USE_STATIC_EMBEDDING=true
# LOG_LEVEL=info

# ---- Standalone Python services (optional) ----
# SO100_PORT=/dev/ttyUSB0
# SO100_BAUD=1000000
# SOMAOS_ROBOT_DRIVER_PORT=3110
# POINTFLOW_PORT=18095
# LOCAL_STT_PORT=18090
